generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Therapist {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  passwordHash  String
  licenseNumber String?
  clinic        String?
  patientIds    String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  notes TherapistNote[]
}

model Patient {
  id                  String   @id @default(uuid())
  name                String
  email               String   @unique
  phone               String?
  passwordHash        String
  diagnosis           String?
  assignedTherapistId String?
  language            Language @default(id)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sessions Session[]
  notes    TherapistNote[]
  prescriptions Prescription[]
}

model Session {
  id                 String        @id @default(uuid())
  patientId          String
  date               DateTime
  exercise           Exercise
  peakRom            Float?
  avgRom             Float?
  repsCompleted      Int?
  consistency        Consistency?
  pain               PainLevel?
  avgSmoothness      Float?
  ceilingHits        Int?
  prescriptionSource String?
  notes              String?
  gyroRawSampleCount Int?
  syncedAt           DateTime?
  reviewStatus       ReviewStatus  @default(unreviewed)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, date])
}

model Prescription {
  id          String   @id @default(uuid())
  patientId   String
  exercise    Exercise
  targetRom   Float
  romCeiling  Float
  targetReps  Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, exercise])
}

model TherapistNote {
  id          String   @id @default(uuid())
  therapistId String
  patientId   String
  weekNumber  Int
  note        String
  templateKey String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

enum Language {
  id
  en
}

enum Exercise {
  forearm_supination
  shoulder_abduction
  elbow_flexion
  wrist_flexion
  finger_extension
  resistance_band_row
}

enum Consistency {
  low
  medium
  high
}

enum PainLevel {
  none
  mild
  stopped
}

enum ReviewStatus {
  unreviewed
  good
  attention
}
